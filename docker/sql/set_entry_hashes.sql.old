update vshow.entry
set hash = z.hash
from ( select id, 
       substring(y.c from cast(rownum/40 as int) +1 for 1) 
       || substring(y.c from cast(rownum%40 as int) +1 for 1) hash
  from (
    select ey.id, row_number() OVER () - 1 ROWNUM 
    from vshow.entry ey
    join vshow.entrant e
      on e.id = ey.entrant_id
    join vshow.current_year cy
      on cy.year_id = e.year_id
    ) as x
  cross join ( select 'aAbBcdDeEfgGhHjklmnoPqQrRstTuvwxy2346789' as c ) as y
) as z
where vshow.entry.id = z.id
